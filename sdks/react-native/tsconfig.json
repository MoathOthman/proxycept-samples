{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "declaration": true,
    "outDir": "lib",
    "rootDir": "src",
    "skipLibCheck": false,
    "verbatimModuleSyntax": false,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2020"
    ],
    "types": []
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "tests"
  ]
}
